# Neon: usa la cadena de conexión con pooler (host con "-pooler").
# El rol debe ser el dueño de las tablas (neondb_owner) y NO superusuario:
# las políticas RLS están forzadas y un superusuario las ignoraría.
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require

# Conexiones por instancia (serverless: bajo).
DATABASE_POOL_MAX=5

# Token compartido con un proveedor externo de monitoreo (mínimo 32 caracteres).
# Solo si se usa el webhook /api/webhooks/aml-alerts.
AML_WEBHOOK_SECRET=
