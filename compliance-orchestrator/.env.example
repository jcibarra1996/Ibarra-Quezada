# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Lo usa el webhook, que no tiene sesión de usuario. Ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor AML. Si AML_PROVIDER_URL está vacío se usa el mock local.
AML_PROVIDER_NAME=ComplyAdvantage
AML_PROVIDER_URL=
AML_PROVIDER_API_KEY=
AML_PROVIDER_TIMEOUT_MS=10000

# Token compartido con el proveedor para el webhook de alertas (mínimo 32 caracteres).
AML_WEBHOOK_SECRET=
