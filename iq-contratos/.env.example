# Supabase (Project Settings > API). En local, `npx supabase status` las muestra.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta: solo en el servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Anthropic: solo en el servidor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Muestra accesos rápidos a los usuarios de demostración en la pantalla de ingreso.
# Nunca activarlo en un ambiente con datos reales.
MODO_DEMO=true

# Envío de alertas por correo: preparado pero desactivado en la demo.
ALERTAS_CORREO_ACTIVAS=false
