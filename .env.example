# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key: server-only, never exposed to the client. Used by
# API routes (day-close, quick-add, magic links) and Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Modo Single-Player ──────────────────────────────────────────────
# URL única y secreta. Sin login: quien tenga este valor entra.
# Genera algo largo y random, ej: `openssl rand -hex 24`
APP_ACCESS_KEY=change-me-to-a-long-random-secret

# Cabecera secreta que debe mandar el Atajo de Siri para /api/quick-add
QUICK_ADD_SECRET=change-me-too

# ── WhatsApp (elige UNO de los dos proveedores) ─────────────────────
WHATSAPP_PROVIDER=meta            # "meta" | "twilio"

# Meta Cloud API
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_TO_NUMBER=+52...          # tu número, en formato E.164

# Twilio (alternativa)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+52...

# URL pública de la app (para los links en los mensajes de WhatsApp)
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app

# Secreto compartido entre pg_cron / Edge Functions y Supabase
EDGE_FUNCTION_SECRET=change-me-three
