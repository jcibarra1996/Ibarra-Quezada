# Copia este archivo a .env (local) o configura estas variables en el
# dashboard de Vercel (Project Settings → Environment Variables).
# Nunca subas el archivo .env real ni ningún valor de API key a git.

# Clave de API de Resend (https://resend.com) para el envío de correo
# del formulario de contacto. Requerida.
RESEND_API_KEY=

# Remitente verificado en Resend, formato: "Nombre <correo@dominio-verificado.com>".
# Opcional: si se deja vacío, se usa el remitente de prueba de Resend
# (onboarding@resend.dev), que funciona pero no llega desde el dominio propio.
RESEND_FROM=

# Correo del despacho que recibe cada solicitud del formulario de contacto.
# Requerida.
CONTACT_RECIPIENT=juan@ibarraquezada.com
